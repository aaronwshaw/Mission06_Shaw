@{
}
<!-- A page to confirm that the user wants to delete the movie from their collection   -->
@model Movie

<h1>Are you sure you want to delete</h1>

<h3>@Model.Title</h3>

<form method="post" asp-controller="Home" asp-action="Delete">

    <input type="hidden" asp-for="MovieId"></input>
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-light" asp-controller="Home" asp-action="MovieCollection">Cancel</a>

</form>
